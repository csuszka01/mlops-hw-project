# Copy this file to .env and adjust to your dataset. Never commit .env.
# Place your dataset CSV under data/ and point DATA_PATH at it.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflowdb
PREFECT_DB=prefectdb

# ── Silo ──────────────────────────────────────────────────────────────────────
S3_ACCESS_KEY=s3_user
S3_SECRET_KEY=s3_password
MLFLOW_BUCKET=mlflow-artifacts
DVC_BUCKET=dvc-storage

# ── Host port mapping ─────────────────────────────────────────────────────────
MLFLOW_PORT=5500
S3_API_PORT=5510
S3_CONSOLE_PORT=5511
POSTGRES_HOST_PORT=5532
PREFECT_PORT=5520

# ── Pipeline ──────────────────────────────────────────────────────────────────
PREFECT_API_URL=http://127.0.0.1:5520/api
DATA_PATH=data/dataset.csv
MEASUREMENTS_PATH=data/measurements.csv
TARGET_COLUMN=Actual_Response_Time_min
PROBLEM_TYPE=regression
MLFLOW_TRACKING_URI=http://127.0.0.1:5500
MLFLOW_EXPERIMENT_NAME=ambulance-response-time

# ── Model registry ────────────────────────────────────────────────────────────
MLFLOW_REGISTERED_MODEL_NAME=ambulance-response-regressor
MLFLOW_MODEL_ALIAS=staging
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_MODEL_OWNER=your-name

# ── DVC remote ────────────────────────────────────────────────────────────────
DVC_REMOTE_NAME=storage
DVC_REMOTE_PATH=dvcstore
